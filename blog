#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
POSTS_DIR="$REPO_DIR/_posts"

# Ensure user-installed gems (e.g. ~/gems) are available in non-interactive shells
if ! command -v bundle >/dev/null 2>&1; then
  if [ -d "$HOME/gems/bin" ]; then
    export GEM_HOME="${GEM_HOME:-$HOME/gems}"
    export PATH="$HOME/gems/bin:$PATH"
  fi
fi

usage() {
  cat <<'EOF'
用法: ./blog <命令> [参数]

命令:
  new "<标题>" [slug]         在 _posts/ 下新建一文一目录模板（未给 slug 时默认用纯 ASCII 时间戳）
  import <目录或.md> [slug]   将外部写好的文章目录（含同级图片/子目录）或 .md 文件无缝导入 _posts/
  list                        列出 _posts/ 下的所有文章及关联资源数量
  serve                       本地构建并启动 http://127.0.0.1:4000 实时预览
  build                       仅运行本地 Jekyll 构建校验
  publish [-y] ["提交说明"]   先构建校验，展示变更并在确认后一键 git add + commit + push（别名: pub）
EOF
}

sanitize_slug() {
  local raw="$1"
  local cleaned
  cleaned="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//')"
  printf '%s' "$cleaned"
}

cmd_new() {
  if [ $# -lt 1 ]; then
    echo "错误: 请提供文章标题，例如: ./blog new \"我的笔记\" [可选slug]" >&2
    exit 1
  fi

  local title="$1"
  local slug_arg="${2:-}"
  local date_ymd now_ts slug dir_name target_dir target_file

  date_ymd="$(TZ=Asia/Shanghai date +%Y-%m-%d)"
  now_ts="$(TZ=Asia/Shanghai date '+%Y-%m-%d %H:%M:%S +0800')"

  if [ -n "$slug_arg" ]; then
    slug="$(sanitize_slug "$slug_arg")"
    if [ -z "$slug" ]; then
      echo "错误: slug 仅支持英文字母、数字、连字符和下划线。" >&2
      exit 1
    fi
  else
    slug="$(TZ=Asia/Shanghai date +%H%M%S)"
  fi

  dir_name="${date_ymd}-${slug}"
  target_dir="$POSTS_DIR/$dir_name"
  target_file="$target_dir/index.md"

  if [ -e "$target_dir" ]; then
    echo "错误: 目标目录已存在: $target_dir" >&2
    exit 1
  fi

  mkdir -p "$target_dir"
  cat > "$target_file" <<EOF
---
layout: post
title: "$(printf '%s' "$title" | sed 's/"/\\"/g')"
date: $now_ts
categories: [杂文]
tags: []
---

这里写首页展示的开头摘要。
<!--more-->

## 正文

把图片直接放在当前目录（_posts/$dir_name/）下，正文直接用相对路径引用即可，例如：![](cover.png)
EOF

  echo "已创建文章目录: _posts/$dir_name/"
  echo "入口文件:       _posts/$dir_name/index.md"
  echo "提示:           图片直接放入该目录即可，本地与线上均用相对路径引用。"
}

cmd_import() {
  if [ $# -lt 1 ]; then
    echo "错误: 请指定要导入的文章目录或 .md 文件路径，例如: ./blog import ~/notes/my-post [可选slug]" >&2
    exit 1
  fi

  local src="$1"
  local slug_arg="${2:-}"

  if [ ! -e "$src" ]; then
    echo "错误: 找不到路径: $src" >&2
    exit 1
  fi

  local date_ymd now_ts base_name slug dir_name target_dir src_md
  date_ymd="$(TZ=Asia/Shanghai date +%Y-%m-%d)"
  now_ts="$(TZ=Asia/Shanghai date '+%Y-%m-%d %H:%M:%S +0800')"

  if [ -d "$src" ]; then
    base_name="$(basename "${src%/}")"
    if [ -f "$src/index.md" ]; then
      src_md="$src/index.md"
    else
      mapfile -t md_files < <(find "$src" -maxdepth 1 -type f -name '*.md' ! -name '.*' | sort)
      if [ "${#md_files[@]}" -eq 1 ]; then
        src_md="${md_files[0]}"
      elif [ "${#md_files[@]}" -eq 0 ]; then
        echo "错误: 目录中没有找到 .md 文件: $src" >&2
        exit 1
      else
        echo "错误: 目录中存在多个顶层 .md 文件，请将主文章命名为 index.md 后再导入。" >&2
        printf '  - %s\n' "${md_files[@]}" >&2
        exit 1
      fi
    fi
  elif [ -f "$src" ]; then
    base_name="$(basename "$src" .md)"
    src_md="$src"
  else
    echo "错误: 不支持的路径类型: $src" >&2
    exit 1
  fi

  # Extract date prefix if source already starts with YYYY-MM-DD-
  if [[ "$base_name" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})-(.+)$ ]]; then
    date_ymd="${BASH_REMATCH[1]}"
    base_name="${BASH_REMATCH[2]}"
  fi

  if [ -n "$slug_arg" ]; then
    slug="$(sanitize_slug "$slug_arg")"
  else
    slug="$(sanitize_slug "$base_name")"
    [ -z "$slug" ] && slug="$(TZ=Asia/Shanghai date +%H%M%S)"
  fi

  dir_name="${date_ymd}-${slug}"
  target_dir="$POSTS_DIR/$dir_name"

  if [ -e "$target_dir" ]; then
    echo "错误: 目标目录已存在: $target_dir（可传入第二个参数指定新 slug）" >&2
    exit 1
  fi

  mkdir -p "$target_dir"

  if [ -d "$src" ]; then
    # Copy all non-hidden files/subdirs except the source markdown (which becomes index.md)
    ruby -rfind -rfileutils -rpathname -e '
      src_root = Pathname.new(File.expand_path(ARGV[0]))
      src_md = Pathname.new(File.expand_path(ARGV[1]))
      dst_root = Pathname.new(File.expand_path(ARGV[2]))
      Find.find(src_root.to_s) do |entry|
        next if entry == src_root.to_s
        base = File.basename(entry)
        if base.start_with?(".") || base == "node_modules"
          Find.prune if File.directory?(entry)
          next
        end
        next unless File.file?(entry)
        p = Pathname.new(entry)
        next if p == src_md
        rel = p.relative_path_from(src_root).to_s
        dst = dst_root.join(rel)
        FileUtils.mkdir_p(dst.dirname)
        FileUtils.cp(p, dst)
      end
    ' "$src" "$src_md" "$target_dir"
  fi

  # Copy markdown into index.md, auto-prepending YAML front matter if absent
  ruby -e '
    src_md, dst_md, fallback_title, now_ts = ARGV
    content = File.read(src_md, encoding: "UTF-8").gsub("\r\n", "\n")
    if content.start_with?("---\n")
      File.write(dst_md, content)
      puts "已保留原有 Front Matter。"
    else
      title = fallback_title
      if content =~ /\A\s*#\s+(.+?)\s*$/
        title = Regexp.last_match(1).strip
        content = content.sub(/\A\s*#\s+.+?\n+/, "")
      end
      escaped = title.gsub("\\", "\\\\\\\\").gsub("\"", "\\\\\"")
      fm = <<~YAML
        ---
        layout: post
        title: "#{escaped}"
        date: #{now_ts}
        categories: [杂文]
        tags: []
        ---

      YAML
      File.write(dst_md, fm + content)
      puts "检测到原文件无 Front Matter，已自动补全（标题: #{title}），请按需修改 categories/tags。"
    end
  ' "$src_md" "$target_dir/index.md" "$base_name" "$now_ts"

  local asset_count
  asset_count="$(find "$target_dir" -type f ! -name 'index.md' | wc -l | tr -d ' ')"
  echo "导入完成: _posts/$dir_name/ （含 index.md 及 $asset_count 个资源文件）"
}

cmd_list() {
  ruby -rfind -rdate -ryaml -e '
    posts_dir = ARGV[0]
    entries = []
    Dir.children(posts_dir).sort.each do |name|
      next if name.start_with?(".")
      full = File.join(posts_dir, name)
      if File.directory?(full) && File.file?(File.join(full, "index.md"))
        md = File.join(full, "index.md")
        assets = 0
        Find.find(full) do |f|
          next if f == full
          base = File.basename(f)
          if base.start_with?(".")
            Find.prune if File.directory?(f)
            next
          end
          assets += 1 if File.file?(f) && f != md
        end
        kind = "目录(#{assets}资源)"
      elsif File.file?(full) && name.end_with?(".md")
        md = full
        kind = "单文件"
      else
        next
      end
      text = File.read(md, encoding: "UTF-8")
      fm = text =~ /\A---\r?\n(.*?)\r?\n---/m ? (YAML.safe_load(Regexp.last_match(1), permitted_classes: [Time, Date]) || {}) : {}
      entries << [name, kind, fm["title"] || "(无标题)", Array(fm["categories"]).join("/"), Array(fm["tags"]).join(",")]
    end
    entries.reverse_each do |name, kind, title, cats, tags|
      puts "#{name}  [#{kind}]  #{title}  {类别: #{cats.empty? ? "-" : cats} | 标签: #{tags.empty? ? "-" : tags}}"
    end
  ' "$POSTS_DIR"
}

cmd_build() {
  cd "$REPO_DIR"
  bundle exec jekyll build
}

cmd_serve() {
  cd "$REPO_DIR"
  echo "正在启动本地预览: http://127.0.0.1:4000 （按 Ctrl+C 停止）"
  exec bundle exec jekyll serve --host 127.0.0.1
}

cmd_publish() {
  local auto_yes=false
  if [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then
    auto_yes=true
    shift
  fi
  local msg="${1:-}"

  cd "$REPO_DIR"

  if [ -z "$(git status --porcelain)" ]; then
    echo "工作区没有待提交的改动。"
    exit 0
  fi

  echo "=== 1/3 本地构建校验 ==="
  bundle exec jekyll build

  echo ""
  echo "=== 2/3 待提交变更 ==="
  git status -s

  if [ -z "$msg" ]; then
    msg="Update blog ($(TZ=Asia/Shanghai date '+%Y-%m-%d %H:%M'))"
  fi
  echo ""
  echo "提交说明: $msg"

  if [ "$auto_yes" != true ]; then
    read -r -p "确认提交并推送到 origin/main？[y/N] " ans
    case "$ans" in
      y|Y|yes|YES) ;;
      *)
        echo "已取消，未执行 commit 或 push。"
        exit 0
        ;;
    esac
  fi

  echo ""
  echo "=== 3/3 提交并推送 ==="
  git add -A
  git commit -m "$msg"
  git push origin main
  echo "推送完成！GitHub Actions 正在自动构建部署，请稍候约 1 分钟查看 https://harwirz.github.io"
}

case "${1:-help}" in
  new) shift; cmd_new "$@" ;;
  import) shift; cmd_import "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  build|check) shift; cmd_build "$@" ;;
  serve|preview) shift; cmd_serve "$@" ;;
  publish|pub) shift; cmd_publish "$@" ;;
  -h|--help|help) usage ;;
  *)
    echo "未知命令: $1" >&2
    usage >&2
    exit 1
    ;;
esac
